:root {
    --bg-1: #edf3ff;
    --bg-2: #dfe7ff;
    --bg-3: #eff6ff;
    --panel: rgba(255, 255, 255, 0.72);
    --panel-strong: #ffffff;
    --panel-soft: #f7f9ff;
    --primary: #4f46e5;
    --primary-strong: #3528c9;
    --secondary: #2563eb;
    --accent: #8b5cf6;
    --text: #0f172a;
    --muted: #5b6475;
    --line: rgba(99, 102, 241, 0.15);
    --shadow: rgba(79, 70, 229, 0.18);
    --success: #22c55e;
    --warning: #f59e0b;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: 'Inter', sans-serif;
    color: var(--text);
    background:
        radial-gradient(circle at top left, rgba(99, 102, 241, 0.22), transparent 26%),
        radial-gradient(circle at bottom right, rgba(37, 99, 235, 0.18), transparent 18%),
        linear-gradient(135deg, var(--bg-3), var(--bg-1) 32%, var(--bg-2));
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 28px 20px 40px;
}

a {
    text-decoration: none;
}

button {
    font: inherit;
    cursor: pointer;
}

.home-shell {
    width: min(1180px, 100%);
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 32px;
    box-shadow: 0 25px 80px rgba(79, 70, 229, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 20px 28px 30px;
}

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 4px 4px 18px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
}

.brand-row {
    display: flex;
    align-items: center;
    gap: 14px;
}

.brand-badge {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 800;
    letter-spacing: 0.08em;
    box-shadow: 0 12px 24px rgba(79, 70, 229, 0.24);
}

.brand-copy {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
}

.brand-name {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--text);
}

.brand-subtitle {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
}

.main-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
}

.main-nav a {
    color: rgba(15, 23, 42, 0.72);
    font-size: 0.92rem;
    font-weight: 600;
    transition: color 0.2s ease;
}

.main-nav a:hover {
    color: var(--primary);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.ghost-button,
.primary-button,
.secondary-button {
    border-radius: 12px;
    padding: 0.82rem 1.2rem;
    font-weight: 700;
    font-size: 0.92rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.ghost-button {
    background: rgba(255, 255, 255, 0.4);
    border: 1px solid rgba(79, 70, 229, 0.12);
    color: var(--text);
}

.primary-button {
    border: none;
    color: #fff;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    box-shadow: 0 12px 22px rgba(79, 70, 229, 0.24);
}

.secondary-button {
    background: rgba(255, 255, 255, 0.45);
    border: 1px solid rgba(148, 163, 184, 0.35);
    color: var(--text);
}

.ghost-button:hover,
.primary-button:hover,
.secondary-button:hover {
    transform: translateY(-1px);
}

.content {
    padding-top: 26px;
}

.hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 28px;
    padding: 20px 6px 12px;
}

.hero-copy {
    padding-right: 16px;
}

.eyebrow {
    margin: 0 0 12px;
    color: var(--primary);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.eyebrow.small {
    margin: 0 0 8px;
    font-size: 0.7rem;
}

.hero-copy h1 {
    margin: 0;
    font-size: clamp(2.7rem, 5vw, 4.3rem);
    line-height: 0.94;
    letter-spacing: -0.07em;
    max-width: 620px;
}

.lead {
    margin: 18px 0 0;
    max-width: 560px;
    color: var(--muted);
    font-size: 1.04rem;
    line-height: 1.7;
}

.cta-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 30px;
    flex-wrap: wrap;
}

.mini-metrics {
    list-style: none;
    padding: 0;
    margin: 30px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(110px, 1fr));
    gap: 14px;
}

.mini-metrics li {
    background: rgba(255, 255, 255, 0.42);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 18px;
    padding: 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.mini-metrics strong {
    font-size: 1.4rem;
    letter-spacing: -0.05em;
}

.mini-metrics span {
    color: var(--muted);
    font-size: 0.82rem;
}

.hero-panel {
    display: flex;
    justify-content: center;
}

.panel-card {
    width: min(100%, 440px);
    background: rgba(255, 255, 255, 0.62);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 24px;
    box-shadow: 0 22px 44px rgba(15, 23, 42, 0.08);
    padding: 20px 20px 18px;
}

.panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
}

.status-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.42rem 0.7rem;
    background: rgba(79, 70, 229, 0.12);
    color: var(--primary);
    font-size: 0.72rem;
    font-weight: 700;
}

.status-pill.subtle {
    background: rgba(37, 99, 235, 0.08);
    color: var(--secondary);
}

.score-ring {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    position: relative;
    margin: 18px auto 16px;
    background: conic-gradient(var(--primary) 0 84%, rgba(79, 70, 229, 0.12) 84% 100%);
    display: grid;
    place-items: center;
    box-shadow: inset 0 0 20px rgba(79, 70, 229, 0.08);
}

.score-ring::before {
    content: "";
    position: absolute;
    inset: 18px;
    border-radius: 50%;
    background: linear-gradient(180deg, #ffffff, #f7f9ff);
    border: 1px solid rgba(148, 163, 184, 0.2);
}

.ring-label {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
}

.ring-label strong {
    font-size: 2rem;
    letter-spacing: -0.06em;
}

.ring-label span {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
}

.task-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
}

.task-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--panel-soft);
    border: 1px solid rgba(148, 163, 184, 0.12);
    color: var(--text);
    font-size: 0.94rem;
}

.task-item strong {
    color: var(--primary);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(180px, 1fr));
    gap: 16px;
    margin-top: 20px;
}

.stat-card {
    padding: 20px 18px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.18);
    box-shadow: 0 10px 40px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.stat-label {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 600;
}

.stat-card strong {
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.06em;
}

.stat-card small {
    color: var(--muted);
    font-size: 0.78rem;
}

.feature-layout {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 20px;
    margin-top: 24px;
}

.feature-panel,
.schedule-panel {
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 24px;
    padding: 22px 22px 18px;
}

.section-header h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2vw, 2rem);
    letter-spacing: -0.06em;
}

.feature-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 20px;
}

.feature-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 12px;
    background: rgba(247, 249, 255, 0.8);
    border: 1px solid rgba(99, 102, 241, 0.08);
    border-radius: 16px;
}

.icon-box {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 800;
    flex-shrink: 0;
}

.icon-box.violet {
    background: linear-gradient(135deg, #7c3aed, #4f46e5);
}

.icon-box.blue {
    background: linear-gradient(135deg, #2563eb, #38bdf8);
}

.icon-box.green {
    background: linear-gradient(135deg, #16a34a, #22c55e);
}

.feature-item h3 {
    margin: 0 0 4px;
    font-size: 1.04rem;
}

.feature-item p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
    font-size: 0.92rem;
}

.schedule-list {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.schedule-list li {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(247, 249, 255, 0.82);
    border-radius: 16px;
    border: 1px solid rgba(148, 163, 184, 0.12);
    padding: 12px 12px;
}

.time-block {
    min-width: 76px;
    padding: 9px 12px;
    text-align: center;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.12), rgba(37, 99, 235, 0.1));
    color: var(--primary);
    font-size: 0.8rem;
    font-weight: 800;
}

.schedule-list strong {
    display: block;
    font-size: 0.96rem;
}

.schedule-list small {
    color: var(--muted);
}

@media (max-width: 980px) {
    .topbar,
    .main-nav,
    .nav-actions {
        flex-wrap: wrap;
    }

    .topbar {
        justify-content: center;
    }

    .hero,
    .feature-layout {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 640px) {
    body {
        padding: 16px 12px 32px;
    }

    .home-shell {
        padding: 16px 14px 22px;
        border-radius: 24px;
    }

    .topbar {
        padding-bottom: 14px;
    }

    .main-nav {
        justify-content: center;
        gap: 12px 18px;
    }

    .nav-actions {
        width: 100%;
        justify-content: center;
    }

    .hero {
        padding-top: 10px;
    }

    .hero-copy h1 {
        font-size: 2.5rem;
    }

    .cta-row,
    .mini-metrics,
    .stats-grid {
        grid-template-columns: 1fr;
        display: grid;
    }

    .cta-row {
        display: flex;
        flex-direction: column;
        align-items: stretch;
    }

    .ghost-button,
    .primary-button,
    .secondary-button {
        width: 100%;
        text-align: center;
    }
}

