                </article>
                <article class="stat-card">
                    <span class="stat-label">Study streak</span>
                    <strong>14 days</strong>
                    <small>Consistency score</small>
                </article>
            </section>

            <section class="feature-layout">
                <article class="feature-panel">
                    <div class="section-header">
                        <div>
                            <p class="eyebrow small">Learning path</p>
                            <h2>Everything you need to stay focused</h2>
